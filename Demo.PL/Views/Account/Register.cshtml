@using NoteKeeperPro.Web.ViewModels.Identity
@model RegisterViewModel 
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="text-danger"></div>
		<form asp-action="Register">
			<input asp-for="FName" placeholder="Enter First Name"/>
			<span asp-validation-for="FName" class="text-danger"></span>

			<input asp-for="LName" placeholder="Enter Last Name"/>
			<span asp-validation-for="LName" class="text-danger"></span>
			<br />
			<input asp-for="Email" placeholder="Enter Email"/>
			<span asp-validation-for="Email" class="text-danger"></span>
			<br />
			<input asp-for="Password" placeholder="Enter Password"/>
			<span asp-validation-for="Password" class="text-danger"></span>
			<br />
			<input asp-for="ConfirmedPassword" placeholder="Confirm Password"/>
			<span asp-validation-for="ConfirmedPassword" class="text-danger"></span>
			<br />
		
			<div class="wthree-text">
				<label class="anim">
					<input asp-for="IsAgree" class="checkbox" >
					<span>I Agree To The Terms & Conditions</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNUP">
		</form>
		<p>Already have an Account? <a asp-action = "Login"> Login Now!</a></p>
	</div>
</div>
@section ValidationScripts
{
	<partial name="_ValidationScriptsPartial" />
}