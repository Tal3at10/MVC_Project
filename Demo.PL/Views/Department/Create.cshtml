@model DepartmentToCreateDto
@{
    ViewData["Title"] = "Create";
}

<div class="justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Create Department</h1>
    <form method="post" asp-controller="Department" asp-action="Create" class="col-8">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group mb-3">
            <label class="form-label" for="Code">Code</label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span> @*Code is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Name">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span> @*Name is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Description">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="CreationDate">CreationDate</label>
            <input type="date" asp-for="CreationDate" class="form-control" />
        </div>

        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Create" />
            <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark">Back To List</a>
        </div>
    </form>
</div>

@section ValidationScripts
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

