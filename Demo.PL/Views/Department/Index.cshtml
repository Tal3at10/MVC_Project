@model IEnumerable<DepartmentToReturnDto>

@{
    ViewData["Title"] = "Index";
}

<h1>All Departments</h1>
<br />
<a class="btn btn-primary" asp-controller="Department" asp-action="Create">Create Department</a>
<br />

@if (Model.Any())
{
    <table class="table table-striped table-hover mt-3">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                <th>@Html.DisplayNameFor(model => model.First().Code)</th>
                <th>@Html.DisplayNameFor(model => model.First().CreationDate)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var department in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(_ => department.Name)</td>
                    <td>@Html.DisplayFor(_ => department.Code)</td>
                    <td>@Html.DisplayFor(_ => department.CreationDate)</td>

                    <partial name="_ButtonsPartial" model="@department.Id"></partial>
                </tr>

                <!-- Modal goes outside the table row -->
                <div class="modal fade" id="deleteModal-@department.Id" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel-@department.Id" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteModalLabel-@department.Id">Delete Department</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete the department: <strong>@department.Name</strong>?
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-controller="Department" asp-route-id="@department.Id" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <input type="submit" value="Delete" class="btn btn-danger" />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h2>No Departments Found</h2>
    </div>
}
