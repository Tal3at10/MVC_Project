@model DepartmentViewModel

<form method="post" asp-controller="Department" asp-action="@ViewBag.Action" class="col-8">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-group mb-3">
        <label class="form-label" for="Code">Code</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span> @*Code is Required*@
    </div>

    <div class="form-group mb-3">
        <label class="form-label" for="Name">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span> @*Name is Required*@
    </div>

    <div class="form-group mb-3">
        <label class="form-label" for="Description">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-3">
        <label class="form-label" for="CreationDate">CreationDate</label>
        <input type="date" asp-for="CreationDate" class="form-control" />
    </div>

    @if(ViewBag.Action == "Create")
    {
    <div class="mt-4 m-auto">
        <input class="btn btn-primary" type="submit" value="Create" />
        <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark">Back To List</a>
    </div>
    }
    else
    {
    <div class="mt-4 m-auto">
        <input class="btn btn-primary" type="submit" value="Edit" />
        <a asp-controller="Department" asp-action="Index" class="btn btn-outline-dark">Back To List</a>
    </div>
    }
</form>