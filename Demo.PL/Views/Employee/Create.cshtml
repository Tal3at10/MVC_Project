@using Demo.BLL.Dtos.Employees
@using Demo.DAL.Entities.Common.Enums
@model EmployeeToCreateDto

@{
    ViewData["Title"] = "Create";
}

<div class="justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Create Employee</h1>
    <form method="post" asp-controller="Employee" asp-action="Create" class="col-8">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group mb-3">
            <label class="form-label" for="Name">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span> @*Name is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Email">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span> @*Email is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Address">Address</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span> @*Address is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="PhoneNumber">PhoneNumber</label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span> @*PhoneNumber is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Age">Age</label>
            <input asp-for="Age" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span> @*Age is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Salary">Salary</label>
            <input asp-for="Salary" class="form-control" />
            <span asp-validation-for="Salary" class="text-danger"></span> @*Salary is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="HiringDate">HiringDate</label>
            <input type="date" asp-for="HiringDate" class="form-control" />
            <span asp-validation-for="HiringDate" class="text-danger"></span> @*HiringDate is Required*@
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="Gander">Gander</label>
            <div>
                @foreach (Gander ganderOption in Enum.GetValues(typeof(Gander)))
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Gander" value="@ganderOption" />
                        <label class="form-check-label">@ganderOption</label>
                    </div>
                }
                <span asp-validation-for="Gander" class="text-danger"></span> @*Gander is Required*@
            </div>
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="EmployeeType">Employee Type</label>
            <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="form-control">
                <option value="">Select Employee Type</option>
            </select>
            <span asp-validation-for="EmployeeType" class="text-danger"></span>
        </div>

        <div class="form-group mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label" for="IsActive">Is Active</label>
        </div>

        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Create" />
            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-dark">Back To List</a>
        </div>
    </form>
</div>
@section ValidationScripts
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
